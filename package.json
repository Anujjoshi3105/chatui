{
  "name": "chatui",
  "version": "0.1.1",
  "description": "A premium, highly customizable React chatbot library with streaming support and modern UI.",
  "author": "Anuj Joshi",
  "keywords": [
    "react",
    "chatbot",
    "ui-library",
    "streaming",
    "tailwindcss"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/chatui.umd.cjs",
  "module": "./dist/chatui.es.js",
  "types": "./dist/lib.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/chatui.es.js",
      "require": "./dist/chatui.umd.cjs"
    },
    "./dist/chatui.css": "./dist/chatui.css",
    "./dist/index.css": "./dist/chatui.css",
    "./chatui.css": "./dist/chatui.css",
    "./style.css": "./dist/chatui.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build --mode app",
    "build:lib": "npm run typecheck && vite build --mode lib",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "analyze": "vite build --mode app-analyze",
    "analyze:lib": "vite build --mode lib-analyze",
    "test": "vitest run",
    "test:browser": "vite build --mode test && vite build --mode app && playwright test && node scripts/summarize-browser.mjs",
    "test:consumer": "tsc -p tests/consumer/tsconfig.json && node scripts/check-consumer.mjs",
    "check:bundles": "node scripts/check-bundles.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:lib && npm run test:consumer && npm run check:bundles"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.34.3",
    "next-themes": "^0.4.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5",
    "minimatch": "^10.2.4"
  }
}
